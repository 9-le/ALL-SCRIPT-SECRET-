-- تحميل مكتبة Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- إنشاء النافذة الرئيسية
local Window = Rayfield:CreateWindow({
   Name = "Server Hop - Old & Empty",
   LoadingTitle = "جاري التحميل...",
   LoadingSubtitle = "بواسطة Rayfield",
   ConfigurationSaving = {
      Enabled = false
   }
})

-- إنشاء تبويب التحكم
local Tab = Window:CreateTab("الرئيسية", 4483362458)

-- دالة البحث عن سيرفر قديم وقليل اللاعبين
local function HopToOldEmptyServer()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local PlaceId = game.PlaceId
    local JobId = game.JobId

    Rayfield:Notify({
        Title = "جاري البحث...",
        Content = "يتم الجمع بين السيرفرات القديمة والقليلة اللاعبين...",
        Duration = 3,
        Image = 4483362458,
    })

    local cursor = ""
    local candidateServers = {}

    -- تصفح السيرفرات لجلب الخيارات المتاحة
    local count = 0
    repeat
        count = count + 1
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end

        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)

        if success and result and result.data then
            for _, server in ipairs(result.data) do
                -- فلترة السيرفرات: ليست الحالي + فيها شخص واحد أو أقل
                if server.id ~= JobId and server.playing <= 1 and server.playing < server.maxPlayers then
                    table.insert(candidateServers, server.id)
                end
            end
            cursor = result.nextPageCursor or ""
        else
            break
        end
    until cursor == "" or #candidateServers >= 10 or count >= 3

    -- اختيار سيرفر من الأقدم (من نهاية القائمة التي جمعناها)
    if #candidateServers > 0 then
        local targetServerId = candidateServers[#candidateServers] -- يأخذ أقدم سيرفر تم العثور عليه
        TeleportService:TeleportToPlaceInstance(PlaceId, targetServerId, game.Players.LocalPlayer)
    else
        Rayfield:Notify({
            Title = "لم يتم العثور",
            Content = "تعذر العثور على سيرفر قديم فيه شخص واحد حالياً.",
            Duration = 4,
            Image = 4483362458,
        })
    end
end

-- إنشاء الزر في القائمة
local Button = Tab:CreateButton({
   Name = "دخول سيرفر قديم وفاضي/1 لاعب",
   Callback = function()
       HopToOldEmptyServer()
   end,
})

